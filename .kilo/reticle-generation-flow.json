{
  "name": "ai-3d-studio-generation-flow",
  "description": "Verifies the 3D generation pipeline: API submission, SSE progress, status polling, and result delivery. Dev-only, never committed to production.",
  "devOnly": true,
  "baseURL": {
    "dev": "http://localhost:3000",
    "production": null
  },
  "flows": [
    {
      "name": "mesh-generation",
      "steps": [
        {
          "action": "navigate",
          "to": "/generate"
        },
        {
          "assert": {
            "element": { "role": "button", "name": "Generate" },
            "state": "visible"
          }
        },
        {
          "action": "click",
          "on": { "role": "button", "name": "Generate" }
        },
        {
          "assert": {
            "net": {
              "method": "POST",
              "urlContains": "/api/v1/generation",
              "status": 200,
              "count": 1
            }
          }
        },
        {
          "assert": {
            "net": {
              "status": 200,
              "urlContains": "/api/v1/generation",
              "count": 1,
              "body": { "has": "job_id", "has": "status" }
            }
          }
        },
        {
          "assert": {
            "signal": { "name": "generation:queued" }
          }
        }
      ]
    }
  ]
}
