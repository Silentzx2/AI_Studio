# ╔══════════════════════════════════════════════════════════════╗
# ║   AI 3D Studio — Environment Configuration                  ║
# ║   Copy to .env and fill in your values                      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Frontend ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL is DEPRECATED - leave empty for proper API proxying.
# The API proxy at /api/v1/[...path]/route.ts handles backend communication.
NEXT_PUBLIC_API_URL=

# BACKEND_URL is used by the API proxy route at runtime.
# For local development (backend on localhost): http://localhost:8000
BACKEND_URL=http://localhost:8000
# ── Backend ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai3dstudio
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── AI Provider ────────────────────────────────────────────────────────────────
# Options: mock | hunyuan3d | hunyuan3d-2.1 | hunyuan3d-2-mini | trellis | triposr
# All local providers run on-device — no cloud inference APIs required.
AI_PROVIDER=
RUNTIME_MODE=local

# ── GPU / CUDA ─────────────────────────────────────────────────────────────────


# API Configuration
API_V1_PREFIX=/api/v1
DEBUG=false

# Provider Credentials (Optional)
GITHUB_TOKEN=
NVIDIA_NGC_API_KEY=
CIVITAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PROMPT_ENHANCEMENT_ENABLED=false
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# ─────────────────────────────────────────────────────────────────

# auto = detect best GPU automatically
# cpu  = force CPU (slow but works without NVIDIA GPU)
# cuda:0, cuda:1 = specific GPU index
CUDA_DEVICE=auto

# Set to 0 to auto-detect total VRAM. Otherwise set MB limit (e.g. 16000)
MAX_VRAM_MB=0

# Keep this much VRAM free as safety margin (MB)
VRAM_SAFETY_MARGIN_MB=1024

# Unload model from VRAM after each job (recommended for single-GPU setups)
AUTO_UNLOAD_AFTER_JOB=true

# ────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./backend/storage
DOWNLOAD_CHUNK_SIZE_MB=5
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_TIMEOUT_SECONDS=300

# ── Blender ────────────────────────────────────────────────────────────────────
# Path to blender executable. On Ubuntu: /usr/bin/blender or ~/blender/blender
BLENDER_EXECUTABLE=blender
BLENDER_ENABLED=true
BLENDER_TIMEOUT=300

# ── Misc ───────────────────────────────────────────────────────────────────────
APP_NAME="AI 3D Studio API"
APP_VERSION=3.9.4
ENVIRONMENT=production
MAX_CONCURRENT_JOBS=1

# ── Offline mode ───────────────────────────────────────────────────────────────
# Set to true after initial model download to prevent any internet access
OFFLINE_MODE=false
